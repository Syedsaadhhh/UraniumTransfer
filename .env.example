# UraniumTransfer configuration. Every value is optional — the app runs with none
# of these. Copy to `.env` to change behaviour.

# --- Nostr attestations -------------------------------------------------------
# Signing always works offline. Publishing to relays needs a network.
# NOSTR_DISABLE=true                          # turn signing off entirely
# NOSTR_SECRET_KEY=<64 hex chars>             # else an ephemeral key is generated at boot
# NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.nostr.band
# NOSTR_TIMEOUT_MS=4000

# --- AI safety advisor --------------------------------------------------------
# Any OpenAI-compatible endpoint. Without a key, the deterministic rules engine
# answers instead, so the app never depends on the model being reachable.
# Groq preset (free, fast): create a key at https://console.groq.com/keys
# AI_API_KEY=
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=qwen/qwen3.8-27b
# AI_TIMEOUT_MS=12000
# --- other presets ---
# OpenAI:     AI_BASE_URL=https://api.openai.com/v1   AI_MODEL=gpt-4o-mini
# OpenRouter: AI_BASE_URL=https://openrouter.ai/api/v1 AI_MODEL=<model>
# Gemini:     AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  AI_MODEL=gemini-1.5-flash

# --- Payment rails ------------------------------------------------------------
# TRANSFER_MODE=sandbox                        # sandbox | lnd
# TRANSFER_DATA_FILE=data/transfers-sandbox.json
# PORT=3000
# HOST=127.0.0.1
